# Supabase (Pha 0 — di dời Google Sheets -> Supabase, dùng cho supabase/migrate.mjs, KHÔNG lộ ra client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CHỈ cần cho nguồn "warehouses" (sheet toạ độ kho KHÔNG public, xem functions/api/geo.ts).
# Có thể lấy refresh token đã cấp sẵn từ Cloudflare KV (QA_KV / oauth:google_refresh_token).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Supabase phía TRÌNH DUYỆT (Pha 1 — đọc song song để đối chiếu, xem supabase/README.md).
# Tiền tố VITE_ -> Vite nhúng vào bundle client, dùng anon key (KHÔNG dùng service role key ở đây).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "1" -> hiện panel "So sánh Sheet vs Supabase" cho admin trong màn Lịch Tải. Để trống ở production
# cho tới khi đối chiếu xong (mặc định KHÔNG hiện, không ảnh hưởng người dùng thường).
VITE_SUPABASE_SHADOW_COMPARE=
