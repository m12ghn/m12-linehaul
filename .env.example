# ============================================================
# BIẾN MÔI TRƯỜNG — đặt trong Vercel → Settings → Environment Variables
# (bản local: sao chép file này thành .env.local, KHÔNG commit .env.local)
# ============================================================

# --- Supabase (bắt buộc) ---
# Lấy ở Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ⚠ KHOÁ BÍ MẬT — bỏ qua RLS. CHỈ dùng ở API route (server), TUYỆT ĐỐI không
#   để lộ ra client, không đặt tên bắt đầu bằng VITE_ (Vite sẽ nhúng vào bundle).
SUPABASE_SERVICE_ROLE_KEY=
# Schema chứa dữ liệu M12. Để riêng (không dùng `public`) nên DÙNG CHUNG được
# project Supabase với hệ thống khác mà không sợ trùng tên bảng.
# Bỏ trống = "m12". Nhớ thêm tên này vào Settings → API → Exposed schemas.
SUPABASE_SCHEMA=m12

# --- Phiên đăng nhập (bắt buộc) ---
# Chuỗi ngẫu nhiên dài, dùng để ký token phiên. Sinh bằng: openssl rand -base64 48
SESSION_SECRET=
# Khoá dự phòng gửi qua header x-admin-token khi bị khoá ngoài (tuỳ chọn nhưng nên có)
BOOTSTRAP_TOKEN=

# --- Gửi mã OTP qua email (tuỳ chọn — chưa có thì dùng đăng nhập nhanh bằng email GHN) ---
BREVO_API_KEY=
OTP_FROM_EMAIL=thovdt@ghn.vn
OTP_FROM_NAME=Dashboard M12
# "1" = trả mã ngay trong phản hồi khi chưa cấu hình email (CHỈ dùng lúc test)
OTP_DEV_ECHO=

# --- Lịch tự động (Vercel Pro: cron chạy tối thiểu 1 phút/lần) ---
# Vercel TỰ SINH biến này khi bạn khai báo "crons" trong vercel.json — không tự đặt tay.
CRON_SECRET=

# --- Xuất ngược ra Google Sheet (tuỳ chọn) ---
# base64 của file JSON key service account; nhớ share Sheet đích cho email SA quyền Editor
GSHEETS_SA_B64=
EXPORT_SHEET_ID=

# --- Trợ lý AI (giữ nguyên như bản cũ) ---
GEMINI_API_KEY=
GOOGLE_MAPS_KEY=
