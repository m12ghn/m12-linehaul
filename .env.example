# Supabase (Pha 0 — di dời Google Sheets -> Supabase, xem supabase/README.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CHỈ cần cho nguồn "warehouses" (sheet toạ độ kho KHÔNG public, xem functions/api/geo.ts).
# Có thể lấy refresh token đã cấp sẵn từ Cloudflare KV (QA_KV / oauth:google_refresh_token).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
